{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/agents/hooks/claude-code/gabbe-hook.js\" guard-bash", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/agents/hooks/claude-code/gabbe-hook.js\" guard-edit", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/agents/hooks/claude-code/gabbe-hook.js\" session-start", "timeout": 10 }
        ]
      }
    ]
  }
}
